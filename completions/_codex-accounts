#compdef codex-accounts
# zsh completion for codex-accounts.
#
# Install:
#   mkdir -p ~/.zsh/completions
#   cp _codex-accounts ~/.zsh/completions/
#   # In ~/.zshrc:
#   #   fpath=(~/.zsh/completions $fpath)
#   #   autoload -Uz compinit && compinit

_codex_switch_accounts() {
  local home="${CODEX_SWITCH_HOME:-$HOME/.codex-accounts}"
  local -a names
  if [[ -d "$home" ]]; then
    names=("${(@f)$(/bin/ls -1 "$home" 2>/dev/null | grep -v '^\.')}")
    _values 'account' $names
  fi
}

_codex_switch() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'list:list saved accounts'
    'current:print the active account name'
    'info:show account details'
    'save:snapshot live Codex state under a name'
    'use:activate a saved account'
    'init:create an empty snapshot directory'
    'note:set a free-text note on an account'
    'rename:rename an account snapshot'
    'delete:delete an account snapshot'
    'stats:local token usage from state_*.sqlite'
    'quota:live quota via private API (requires network)'
    'refresh:open the 5h window on every account'
    'app:manage Codex Desktop runtime'
    'status:fast local Codex health summary'
    'doctor:print environment diagnostics'
  )

  _arguments -C \
    '1: :->cmd' \
    '*::arg:->args'

  case $state in
    cmd)
      _describe -t commands 'codex-accounts command' commands
      ;;
    args)
      case $line[1] in
        list)
          _arguments '-a[fetch live quota]' '--all[fetch live quota]'
          ;;
        info|stats|quota)
          _codex_switch_accounts
          ;;
        save)
          _arguments '--auth-only[only snapshot auth.json]'
          [[ -z $line[2] ]] && _codex_switch_accounts
          ;;
        use)
          _arguments \
            '--no-share-sessions[fully isolate session DBs]' \
            '-f[skip the codex-running check]' \
            '--force[skip the codex-running check]'
          [[ -z $line[2] ]] && _codex_switch_accounts
          ;;
        init|note|delete)
          [[ -z $line[2] ]] && _codex_switch_accounts
          ;;
        rename)
          _codex_switch_accounts
          ;;
        refresh)
          _arguments \
            '--delay[seconds between accounts]:seconds:' \
            '--dry-run[show plan without sending]'
          ;;
        status)
          _arguments \
            '--since[hours of logs to scan]:hours:' \
            '--json[emit machine-readable JSON]'
          ;;
        app)
          local -a app_commands
          app_commands=(
            'status:fast local Codex health summary'
            'doctor:diagnose Codex Desktop reconnect failures'
            'kill:list or clean Codex Desktop background processes'
            'gc:show Codex home cleanup candidates'
          )
          if [[ -z $line[2] ]]; then
            _describe -t commands 'codex-accounts app command' app_commands
          else
            case $line[2] in
              status)
                _arguments \
                  '--since[hours of logs to scan]:hours:' \
                  '--json[emit machine-readable JSON]'
                ;;
              doctor)
                _arguments \
                  '--since[hours of logs to scan]:hours:' \
                  '--live[run lightweight live HTTP probes]' \
                  '--json[emit machine-readable JSON]'
                ;;
              kill)
                _arguments \
                  '--dry-run[show matching processes without terminating them]' \
                  '1:action:(list stale)'
                ;;
              gc)
                _arguments \
                  '--dry-run[show candidates without changing files]' \
                  '--older-than-days[minimum age for temp/cache candidates]:days:' \
                  '--limit[items to show per bucket]:count:' \
                  '--json[emit machine-readable JSON]' \
                  '1:gc action:(clean)'
                if [[ $line[3] == clean ]]; then
                  _arguments \
                    '--action[candidate action to clean]:action:(remove)' \
                    '--category[exact remove-category name]:category:' \
                    '--path[exact candidate path]:path:_files' \
                    '--older-than-days[minimum age for temp/cache candidates]:days:' \
                    '--dry-run[preview selected deletions]' \
                    '--yes[confirm deletion]' \
                    '--force[allow cleanup while Codex appears to be running]'
                fi
                ;;
            esac
          fi
          ;;
      esac
      ;;
  esac
}

_codex_switch "$@"
